{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Singapore",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Group routine backend updates into one PR",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend Python dependencies"
    },
    {
      "description": "Group routine frontend updates into one PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend npm dependencies"
    },
    {
      "description": "Group CI action updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group container image updates (Dockerfiles, compose, Dev Container)",
      "matchManagers": ["dockerfile", "docker-compose", "devcontainer"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "container images"
    },
    {
      "description": "Major upgrades wait for approval on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  }
}
