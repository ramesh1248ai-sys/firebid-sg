# FireBid SG backend settings. Copy to .env for local overrides. Never commit .env.
FIREBID_ENV=dev
FIREBID_LOG_LEVEL=INFO
FIREBID_DATABASE_URL=postgresql://firebid:firebid@localhost:55432/firebid

# LLM provider credentials, used by the AI gateway from step P0-04 onward.
# Fill a provider's values only once ADR-004 approves it; the gateway refuses providers that are
# not approved for a route's data class, whatever credentials are present.

# Anthropic (Claude API)
FIREBID_LLM_ANTHROPIC_API_KEY=
# Claude through Amazon Bedrock
FIREBID_LLM_BEDROCK_AWS_REGION=
FIREBID_LLM_BEDROCK_AWS_ACCESS_KEY_ID=
FIREBID_LLM_BEDROCK_AWS_SECRET_ACCESS_KEY=
# Claude through Google Vertex AI
FIREBID_LLM_VERTEX_PROJECT_ID=
FIREBID_LLM_VERTEX_REGION=
# Claude through Microsoft Foundry
FIREBID_LLM_FOUNDRY_RESOURCE=
FIREBID_LLM_FOUNDRY_API_KEY=
# OpenAI
FIREBID_LLM_OPENAI_API_KEY=
# Azure OpenAI
FIREBID_LLM_AZURE_OPENAI_ENDPOINT=
FIREBID_LLM_AZURE_OPENAI_API_KEY=
# Google Gemini (Gemini API or Vertex AI)
FIREBID_LLM_GEMINI_API_KEY=
FIREBID_LLM_GEMINI_VERTEX_PROJECT_ID=
FIREBID_LLM_GEMINI_VERTEX_REGION=
# Self-hosted, OpenAI-compatible endpoint
FIREBID_LLM_SELF_HOSTED_BASE_URL=
FIREBID_LLM_SELF_HOSTED_API_KEY=
