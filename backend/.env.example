# FireBid SG backend settings. Copy to backend/.env for local development. Never commit .env.
#
# This file is found from the package, not the working directory, so `backend/.env` works
# whether you run from backend/ or from the repository root.
#
# A real environment variable always wins over this file. In a container the value comes from
# the environment, and a stale .env in a working copy must not override a deployment.
#
# The provider variable names below are the ones `backend/config/llm.yaml` actually reads. If
# you change a `credentials:` reference there, change the name here too — a test fails if the
# two drift apart.

FIREBID_ENV=dev
FIREBID_LOG_LEVEL=INFO
FIREBID_DATABASE_URL=postgresql://firebid:firebid@localhost:55432/firebid

# --- LLM providers ---------------------------------------------------------------------
# Fill in a provider's key to use it. The gateway still refuses any provider that is not
# approved in llm.yaml for a route's data class, whatever credentials are present.

# Anthropic (Claude API). For Bedrock, Vertex or Foundry, set platform/region/project_id in
# llm.yaml; those paths use the cloud provider's own credential chain, not a key here.
ANTHROPIC_API_KEY=

# OpenAI, and Azure OpenAI (set platform: azure, base_url and options.api_version in llm.yaml)
OPENAI_API_KEY=

# Google Gemini. For Vertex AI set platform: vertex with project_id and region in llm.yaml.
GEMINI_API_KEY=

# --- Debugging payload store -----------------------------------------------------------
# Prompts and responses are kept only for bids an administrator has opted in, and only when
# this key is set. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIREBID_PAYLOAD_ENCRYPTION_KEY=

# --- Internal notifications -------------------------------------------------------------
# With no SMTP host, deadline and budget alerts are logged rather than sent.
FIREBID_SMTP_HOST=
FIREBID_SMTP_PORT=587
FIREBID_SMTP_SENDER=firebid@example.com

# --- Document ingestion -------------------------------------------------------------------
# ClamAV. `make up` runs one as the `clamav` service; leave these as they are for local work.
# An unreachable scanner does not let files through: they are held in `awaiting_scan` and
# retried, because the day the scanner is down is the day nobody is watching.
FIREBID_CLAMAV_HOST=clamav
FIREBID_CLAMAV_PORT=3310

# DWG conversion. Empty until ADR-003 records a converter licence (the open converters are
# GPL, which is the decision that is pending). While empty, DWG uploads are refused with a
# message asking for the DXF export instead.
FIREBID_DWG_CONVERTER_COMMAND=
