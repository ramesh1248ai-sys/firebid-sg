# Copy to .env.local for local development. Vite exposes only VITE_-prefixed variables to the
# browser, and bakes them in at build time, so each environment needs its own build.

# Keycloak in development; the Microsoft Entra ID tenant in staging and production, e.g.
# https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/firebid
VITE_OIDC_CLIENT_ID=firebid-web
VITE_OIDC_SCOPE=openid profile email
