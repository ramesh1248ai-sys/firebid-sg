# Environment for the container stack. Copy to infra/.env. Never commit it.
#
# Docker Compose reads .env from the directory holding the compose file, so this belongs at
# infra/.env, not at the repository root. Values here are interpolated into the backend and
# worker containers by infra/docker-compose.yml.
#
# The backend's own backend/.env is not read inside a container: the image does not contain
# it, and the deployment's environment is the source of truth there.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ports, if the defaults clash with something already running.
# FIREBID_WEB_PORT=8080
# FIREBID_API_PORT=8000
# FIREBID_KEYCLOAK_PORT=8081
# FIREBID_PG_PORT=55432
